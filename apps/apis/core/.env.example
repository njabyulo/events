DATABASE_URL=postgresql://example:example@localhost:5432/example
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=35000
DATABASE_APPLICATION_NAME=events-api
PORT=3000
EVENTS_CHANNEL=events_ready
QUEUE_CHANNEL=queue_ready
SSE_CHANNEL=sse_ready
EVENT_MAX_BODY_BYTES=1048576
API_AUTH_TOKEN=example

GITHUB_WEBHOOK_SECRET=example
GENERIC_WEBHOOK_SECRET=example
TELEGRAM_WEBHOOK_SECRET=example

# Add more installations without changing code. Values name secret environment variables;
# secrets themselves do not belong in this JSON.
# WEBHOOK_SOURCES_JSON={"github-career":{"provider":"github","source":"github.career","secretEnv":"GITHUB_CAREER_WEBHOOK_SECRET"}}

WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300

GMAIL_POLL_ENABLED=false
GMAIL_CLIENT_ID=example
GMAIL_CLIENT_SECRET=example
GMAIL_REFRESH_TOKEN=example
GMAIL_LABEL_ID=example
GMAIL_USER_ID=me
GMAIL_POLL_INTERVAL_MS=120000

ROUTER_ENABLED=true
ROUTER_POLL_INTERVAL_MS=5000
ROUTER_RECONNECT_DELAY_MS=5000
ROUTER_LEASE_MS=30000
ROUTER_RETRY_BASE_MS=1000
ROUTER_RETRY_MAX_MS=60000
ROUTER_MAX_ATTEMPTS=10
REPLAY_BATCH_SIZE=100
REPLAY_LEASE_SECONDS=60
REPLAY_MAX_ATTEMPTS=5
REPLAY_RETRY_DELAY_SECONDS=5
