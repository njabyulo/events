QUIET_HOURS_START=21:00
QUIET_HOURS_END=07:00

DASHBOARD_CONSUMER_ENABLED=true
# When AGENT_ENABLED=true, unclassified belongs to the agent consumer.
DASHBOARD_QUEUE_NAMES=career,personal
DASHBOARD_CONSUMER_NAME=dashboard
DASHBOARD_STREAM_KEY=triage
DASHBOARD_POLL_INTERVAL_MS=2000
DASHBOARD_RECONNECT_DELAY_MS=5000
DASHBOARD_VISIBILITY_TIMEOUT_SECONDS=300
DASHBOARD_HEARTBEAT_INTERVAL_MS=100000
DASHBOARD_MAX_CONCURRENCY=4
DASHBOARD_MAX_DEFERRED=500
DASHBOARD_SHUTDOWN_DEADLINE_MS=10000
SSE_HEARTBEAT_MS=15000
SSE_RECONNECT_DELAY_MS=5000
SSE_MAX_CLIENTS=25
SSE_MAX_FRAME_BYTES=262144
DIGEST_SCHEDULER_ENABLED=true
DIGEST_POLL_INTERVAL_MS=60000
DIGEST_VISIBILITY_TIMEOUT_SECONDS=300
DIGEST_BATCH_SIZE=100
DIGEST_CONSUMER_NAME=digest-scheduler

MAINTENANCE_ENABLED=true
MAINTENANCE_POLL_INTERVAL_MS=60000
MAINTENANCE_BATCH_SIZE=100
SSE_DEFAULT_RETENTION_SECONDS=604800

# Strands uses the normal AWS credential chain; do not place AWS secrets in this file.
AGENT_ENABLED=false
AGENT_QUEUE_NAME=unclassified
AGENT_CONSUMER_NAME=strands-agent
AGENT_CONFIDENCE_THRESHOLD=0.75
AGENT_MAX_CANDIDATE_THREADS=20
AGENT_MAX_HISTORY_EVENTS=30
AGENT_MAX_HISTORY_CHARACTERS=12000
AGENT_MAX_CONCURRENCY=2
AGENT_POLL_INTERVAL_MS=2000
AGENT_VISIBILITY_TIMEOUT_SECONDS=180
AGENT_HEARTBEAT_INTERVAL_MS=60000
AGENT_RECONNECT_DELAY_MS=5000
AGENT_SHUTDOWN_DEADLINE_MS=10000
STRANDS_MODEL_ID=global.anthropic.claude-sonnet-4-6
STRANDS_MAX_TOKENS=512
AWS_REGION=us-east-1

TELEGRAM_CONSUMER_ENABLED=false
