{
  "name": "database",
  "version": "1.0.0",
  "description": "",
  "exports": {
    "./escalations": {
      "types": "./dist/escalations.d.mts",
      "default": "./dist/escalations.mjs"
    },
    "./events": {
      "types": "./dist/events.d.mts",
      "default": "./dist/events.mjs"
    },
    "./queues": {
      "types": "./dist/queues.d.mts",
      "default": "./dist/queues.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./routing": {
      "types": "./dist/routing.d.mts",
      "default": "./dist/routing.mjs"
    },
    "./rules": {
      "types": "./dist/rules.d.mts",
      "default": "./dist/rules.mjs"
    },
    "./targets": {
      "types": "./dist/targets.d.mts",
      "default": "./dist/targets.mjs"
    },
    "./triage": {
      "types": "./dist/triage.d.mts",
      "default": "./dist/triage.mjs"
    }
  },
  "scripts": {
    "dev:db:generate": "drizzle-kit generate --config=drizzle-dev.config.ts",
    "dev:db:migrate": "drizzle-kit migrate --config=drizzle-dev.config.ts",
    "dev:db:seed": "tsx seeds/index.ts",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit && tsc --noEmit -p seeds/tsconfig.json",
    "build": "pnpm typecheck && tsdown"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
